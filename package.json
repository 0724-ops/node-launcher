{
  "name": "node-launcher",
  "productName": "Node Launcher",
  "version": "0.1.0",
  "description": "通用 Node 项目启动器 - Node Launcher",
  "main": "dist-electron/main.js",
  "author": {
    "name": "node-launcher"
  },
  "license": "GPL-3.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:electron && vite",
    "dev:electron": "electron .",
    "build:electron": "tsc -p tsconfig.node.json",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run build:electron && npm run typecheck && npm run test",
    "build": "npm run build:electron && vue-tsc --noEmit && vite build && electron-builder --win",
    "build:win": "npm run build:electron && vue-tsc --noEmit && vite build && electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "extract-zip": "^2.0.1",
    "fs-extra": "^11.2.0",
    "pidusage": "^4.0.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "electron": "^36.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0"
  }
}
